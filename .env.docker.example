# Variables du déploiement Docker Compose (copier vers .env.docker)
POSTGRES_DB=contrat_manager
POSTGRES_USER=contrat
POSTGRES_PASSWORD=changez-ce-mot-de-passe
# Générer par exemple avec : openssl rand -hex 32
JWT_SECRET=changez-ce-secret-par-une-longue-chaine-aleatoire
JWT_EXPIRES_IN=12h
# Port public du site
WEB_PORT=8080
