{
  "name": "contrat-manager",
  "version": "2.0.0",
  "description": "Application web de gestion de contrats de mission temporaire (front React)",
  "private": true,
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "dev": "concurrently -n api,web -c blue,green \"npm run start:api\" \"npm run start:web\"",
    "start:web": "cross-env BROWSER=none react-scripts start",
    "start:api": "npm --prefix server run start:dev",
    "api:install": "npm --prefix server install",
    "api:build": "npm --prefix server run build",
    "api:smoke": "npm --prefix server run smoke",
    "db:local": "npm --prefix server run db:local",
    "db:migrate": "npm --prefix server run prisma:migrate",
    "db:reset": "npm --prefix server run db:reset"
  },
  "proxy": "http://localhost:3001",
  "author": "Votre Nom",
  "license": "MIT",
  "dependencies": {
    "@heroicons/react": "^2.0.18",
    "papaparse": "^5.5.3",
    "react": "^18.2.0",
    "react-datepicker": "^8.3.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.14.0",
    "react-scripts": "5.0.1",
    "react-toastify": "^11.0.5",
    "recharts": "^2.15.3",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.14",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "postcss": "^8.4.24",
    "tailwindcss": "^3.3.2"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
