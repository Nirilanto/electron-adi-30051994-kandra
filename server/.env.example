# Connexion PostgreSQL
DATABASE_URL=postgresql://contrat:contrat@localhost:5432/contrat_manager?schema=public
# Port HTTP de l'API
PORT=3001
# Secret de signature des jetons JWT (obligatoire, long et aléatoire en production)
JWT_SECRET=change-me-with-a-long-random-string
# Durée de validité des sessions
JWT_EXPIRES_IN=12h
# Origines autorisées (CORS), séparées par des virgules. Vide = même origine uniquement.
CORS_ORIGINS=http://localhost:3000
# Chemin de Chromium/Chrome pour la génération PDF (laisser vide pour auto-détection)
PUPPETEER_EXECUTABLE_PATH=
