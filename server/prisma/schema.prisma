// Schéma PostgreSQL de Contrat Manager.
//
// Principe : chaque entité métier possède des colonnes typées (identifiants,
// clés étrangères, statuts, dates et montants utilisés pour filtrer / trier)
// ET une colonne `data` JSONB qui conserve le document complet tel que le
// front le manipule. Les colonnes typées sont dérivées de `data` à chaque
// écriture, ce qui garantit l'intégrité relationnelle sans changer le format
// des objets côté React (zéro régression fonctionnelle).
//
// Les dates sont stockées en texte ISO (comme produites par le front) pour
// conserver un aller-retour exact ; la colonne `date` des pointages est au
// format AAAA-MM-JJ et comparée telle quelle.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- Utilisateurs

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         String   @default("user") // admin | user
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

// ---------------------------------------------------------------- Employés

model Employee {
  id                   Int      @id @default(autoincrement())
  firstName            String?  @map("first_name")
  lastName             String?  @map("last_name")
  email                String?
  phone                String?
  mobile               String?
  city                 String?
  postalCode           String?  @map("postal_code")
  status               String   @default("active")
  employeeNumber       String?  @map("employee_number")
  qualification        String?
  nationality          String?
  hourlyRate           Float?   @map("hourly_rate")
  socialSecurityNumber String?  @map("social_security_number")
  hireDate             String?  @map("hire_date")
  departureDate        String?  @map("departure_date")
  data                 Json
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  contracts   Contract[]
  timeEntries TimeEntry[]
  payslips    Payslip[]

  @@index([lastName, firstName])
  @@index([status])
  @@map("employees")
}

// ---------------------------------------------------------------- Clients

model Client {
  id           Int      @id @default(autoincrement())
  companyName  String?  @map("company_name")
  contactName  String?  @map("contact_name")
  email        String?
  phone        String?
  siret        String?
  city         String?
  postalCode   String?  @map("postal_code")
  status       String   @default("active")
  clientNumber String?  @map("client_number")
  data         Json
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  contracts   Contract[]
  invoices    Invoice[]
  timeEntries TimeEntry[]

  @@index([companyName])
  @@index([status])
  @@map("clients")
}

// ---------------------------------------------------------------- Contrats

model Contract {
  id             String   @id @default(uuid())
  contractNumber Int?     @map("contract_number")
  title          String?
  employeeId     Int?     @map("employee_id")
  clientId       Int?     @map("client_id")
  startDate      String?  @map("start_date")
  endDate        String?  @map("end_date")
  location       String?
  hourlyRate     Float?   @map("hourly_rate")
  billingRate    Float?   @map("billing_rate")
  signatureId    Int?     @map("signature_id")
  stampId        Int?     @map("stamp_id")
  data           Json
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  employee    Employee?   @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  client      Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  timeEntries TimeEntry[]

  @@index([contractNumber])
  @@index([employeeId])
  @@index([clientId])
  @@index([startDate, endDate])
  @@map("contracts")
}

// ---------------------------------------------------------------- Pointages

model TimeEntry {
  id            String   @id @default(uuid())
  employeeId    Int?     @map("employee_id")
  contractId    String?  @map("contract_id")
  clientId      Int?     @map("client_id")
  date          String   @db.VarChar(10) // AAAA-MM-JJ
  totalHours    Float?   @map("total_hours")
  normalHours   Float?   @map("normal_hours")
  overtimeHours Float?   @map("overtime_hours")
  hourlyRate    Float?   @map("hourly_rate")
  billingRate   Float?   @map("billing_rate")
  status        String   @default("draft") // draft | validated | invoiced
  workType      String?  @map("work_type")
  invoiceId     Int?     @map("invoice_id")
  data          Json
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  contract Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  client   Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@unique([employeeId, contractId, date])
  @@index([date])
  @@index([status])
  @@index([contractId])
  @@index([clientId])
  @@map("time_entries")
}

// ---------------------------------------------------------------- Factures

model Invoice {
  id            Int      @id @default(autoincrement())
  invoiceNumber String?  @map("invoice_number")
  clientId      Int?     @map("client_id")
  status        String   @default("draft") // draft | sent | paid | overdue | rejected
  invoiceDate   String?  @map("invoice_date")
  dueDate       String?  @map("due_date")
  periodStart   String?  @map("period_start")
  periodEnd     String?  @map("period_end")
  totalAmount   Float?   @map("total_amount")
  isFinalized   Boolean  @default(false) @map("is_finalized")
  data          Json
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([invoiceNumber])
  @@index([clientId])
  @@index([status])
  @@index([invoiceDate])
  @@map("invoices")
}

// ---------------------------------------------------------------- Bulletins de paie

model Payslip {
  id          Int      @id @default(autoincrement())
  employeeId  Int?     @map("employee_id")
  periodStart String?  @map("period_start")
  periodEnd   String?  @map("period_end")
  paymentDate String?  @map("payment_date")
  status      String   @default("draft")
  data        Json
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([employeeId, periodEnd])
  @@map("payslips")
}

// ---------------------------------------------------------------- Paramètres

/// Paramètres de l'entreprise (une seule ligne, id = 1)
model CompanySettings {
  id        Int      @id @default(1)
  data      Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("company_settings")
}

/// Listes de référence : tax_rates, hour_types, payment_methods, transport_modes,
/// qualifications, motif_types, justificatif_types, access_methods, security_measures.
/// L'identifiant est propre à chaque liste (clé composite), comme dans l'application d'origine.
model ReferenceItem {
  kind      String
  id        Int
  title     String?
  label     String?
  data      Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([kind, id])
  @@map("reference_items")
}

/// Signatures et tampons (images base64)
model Signature {
  id        Int      @id @default(autoincrement())
  title     String?
  type      String?  // signature | stamp
  imageData String?  @map("image_data") @db.Text
  data      Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("signatures")
}

/// Compteurs atomiques (numéro de contrat, numéro de facture)
model Counter {
  name  String @id
  value Int    @default(0)

  @@map("counters")
}

/// Clé/valeur générique (historique PDF, nationalités personnalisées, ...)
model KvEntry {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("kv_store")
}
